# SASRIAKAL Environment Configuration
# Copy to .env and adjust as needed

# Server
SASRIAKAL_HOST=0.0.0.0
SASRIAKAL_PORT=8000
SASRIAKAL_RELOAD=true
SASRIAKAL_WORKERS=1

# CORS (comma-separated)
SASRIAKAL_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,chrome-extension://*

# Model
SASRIAKAL_DEVICE=auto          # auto | cpu | cuda
SASRIAKAL_THRESHOLD=0.65
SASRIAKAL_MESO_WEIGHT=0.4
SASRIAKAL_RESNET_WEIGHT=0.6

# Upload limits
SASRIAKAL_MAX_UPLOAD_MB=100

# WebSocket
SASRIAKAL_MAX_WS=50
SASRIAKAL_WS_FPS_LIMIT=30

# Logging
SASRIAKAL_LOG_LEVEL=INFO
